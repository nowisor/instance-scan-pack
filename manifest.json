  "tools": [
    {
      "id": "security-log-export",
      "version": "1.0.0",
      "type": "BackgroundScript",
      "emits_schema": "logexport_schema_version",
      "path": "tools/security-log-export.js",
      "purpose": "Twin-sensor #2: emits log-export schema v1 envelope (sys_audit on role/security/properties tables + sysevent discovery + syslog_transaction top-25 by user) over a configurable lookback window. Read-only. Pure sensor — no correlation logic."
    },
    {
      "id": "ai-discovery-export",
      "version": "1.0.0",
      "type": "BackgroundScript",
      "emits_schema": "aidiscovery_schema_version",
      "path": "tools/ai-discovery-export.js",
      "check_group": "ai-agent-security",
      "purpose": "Phase 0 sensor: emits ai-discovery schema v1 envelope. Enumerates the agentic surface (plugins present/absent, sys_db_object scope-prefix scan, per-table sys_dictionary field resolution, AI Control Tower + MCP/Action Fabric state, external LLM endpoints, log sources with their earliest record). Read-only. Pure sensor - no verdicts. Enumeration-driven by design: no sn_aia / sn_now_assist identifier is asserted from memory, because that namespace is paid-SKU gated and cannot satisfy CLAUDE.md evidence leg (a)."
    },
    {
      "id": "ai-bom-export",
      "version": "1.0.0",
      "type": "BackgroundScript",
      "emits_schema": "aibom_schema_version",
      "path": "tools/ai-bom-export.js",
      "check_group": "ai-agent-security",
      "purpose": "Phase A sensor: emits ai-bom schema v1 envelope, one record per agentic entity with NHI lifecycle attributes (owner, lifecycle state, run-as, last review, governance registration). Every attribute carries a resolution state - set | empty | unresolved - so the advisor can distinguish a real gap (empty) from a field the release does not expose (unresolved). Read-only. Pure sensor - no verdicts."
    },
    {
      "id": "ai-usage-export",
      "version": "1.0.0",
      "type": "BackgroundScript",
      "emits_schema": "aiusage_schema_version",
      "path": "tools/ai-usage-export.js",
      "check_group": "ai-agent-security",
      "purpose": "Phase B sensor: emits ai-usage schema v1 envelope. Per agentic entity the PERMISSION ENVELOPE (run-as roles with lineage and inheritance chain, ACL write reach, cross-scope privileges, MCP tool packages) and the INVOCATION EVIDENCE attributed to the run-as identity, plus each log source's earliest record. Read-only. Pure sensor - no verdicts. The retention floors are what let the advisor's coverage gate decide whether DORMANT is defensible; without them every permission degrades to UNKNOWN-USAGE. Respects a per-scan query budget and reports a truncated run rather than passing it off as complete."
    }
  ]
}
